@prefix co: <http://purl.org/co/> .
@prefix drafting: <http://example.org/ontology/drafting/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-types: <https://ontology.unifiedcyberontology.org/uco/types/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

drafting:ActionLifecycle-shape
	a sh:NodeShape ;
	rdfs:comment "This shape replaces anonymous property shapes unintentionallydeactivated by deactivating uco-action:ActionLifecycle while adding one new property shape to support the proposal."@en ;
	sh:property
		[
			rdfs:comment "This property shape is proposed to move into uco-action:ArrayOfAction."@en ;
			rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/678> ;
			sh:class drafting:ThreadOfActions ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:nodeKind sh:IRI ;
			sh:path drafting:phaseThread ;
		] ,
		[
			rdfs:isDefinedBy uco-action:ActionLifecycle ;
			sh:class uco-core:UcoObject ;
			sh:maxCount "0"^^xsd:integer ;
			sh:nodeKind sh:IRI ;
			sh:path uco-action:error ;
		] ,
		[
			rdfs:isDefinedBy uco-action:ActionLifecycle ;
			sh:datatype xsd:dateTime ;
			sh:maxCount "0"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path uco-action:endTime ;
		] ,
		[
			rdfs:isDefinedBy uco-action:ActionLifecycle ;
			sh:datatype xsd:dateTime ;
			sh:maxCount "0"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path uco-action:startTime ;
		] ,
		[
			rdfs:isDefinedBy uco-action:ActionLifecycle ;
			sh:datatype xsd:nonNegativeInteger ;
			sh:maxCount "0"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path uco-action:actionCount ;
		] ,
		[
			rdfs:isDefinedBy uco-action:ActionLifecycle ;
			sh:maxCount "0"^^xsd:integer ;
			sh:path uco-action:actionStatus ;
		]
		;
	sh:targetClass uco-action:ActionLifecycle ;
	.

drafting:ThreadOfActions
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf
		uco-core:UcoInherentCharacterizationThing ,
		uco-types:Thread ,
		[
			a owl:Restriction ;
			rdfs:comment "A thread of actions groups and orders at least one action.  While there should be at least one Action linked, to allow for partial information sharing, this minimal link missing is warned about if absent, but not enforced."@en ;
			rdfs:seeAlso drafting:ThreadOfActions-actions-shape ;
			owl:onProperty co:element ;
			owl:someValuesFrom uco-action:Action ;
		] ,
		[
			a owl:Restriction ;
			rdfs:comment "A thread of actions groups and orders at least one action.  While there should be at least one ThreadItem linked, to allow for partial information sharing, this minimal link missing is warned about if absent, but not enforced."@en ;
			rdfs:seeAlso drafting:ThreadOfActions-actions-shape ;
			owl:onProperty co:item ;
			owl:someValuesFrom uco-types:ThreadItem ;
		]
		;
	rdfs:label "ThreadOfActions"@en ;
	rdfs:comment "A thread of actions is a partially ordered set of references to actions that are performed as a group.  As a summary of the member actions, co:element can directly link the ordered actions; but, the order between the actions is set by ThreadItems linked by co:item."@en ;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/678> ;
	sh:property
		[
			sh:class uco-action:Action ;
			sh:path co:element ;
		] ,
		[
			sh:class uco-action:Action ;
			sh:path (
				co:item
				co:itemContent
			) ;
		] ,
		[
			sh:class uco-types:ThreadItem ;
			sh:path co:item ;
		]
		;
	sh:targetClass drafting:ThreadOfActions ;
	.

drafting:ThreadOfActions-actions-shape
	a sh:NodeShape ;
	rdfs:comment "This shape checks whether a ThreadOfActions links to an Action in an ordered or unordered manner.  In scenarios with partial data sharing where the thread is intended to be indicated but not defined, this shape can be deactivated to quiet warnings."@en ;
	sh:property
		drafting:ThreadOfActions-element-shape ,
		drafting:ThreadOfActions-item-shape
		;
	sh:targetClass drafting:ThreadOfActions ;
	.

drafting:ThreadOfActions-element-shape
	a sh:PropertyShape ;
	sh:message "Some Action(s) should be directly linked to a ThreadOfActions with co:element."@en ;
	sh:minCount "1"^^xsd:integer ;
	sh:path co:element ;
	sh:severity sh:Warning ;
	.

drafting:ThreadOfActions-item-shape
	a sh:PropertyShape ;
	sh:message "Some ThreadItem(s) should be linked to a ThreadOfActions with co:item."@en ;
	sh:minCount "1"^^xsd:integer ;
	sh:path co:item ;
	sh:severity sh:Warning ;
	.

drafting:phaseThread
	a owl:ObjectProperty ;
	rdfs:subPropertyOf uco-action:subaction ;
	rdfs:label "phaseThread"@en ;
	rdfs:comment
		"Note:This property might or might not replace uco-action:phase."@en ,
		"The partially ordered set of actions or sub action-lifecycles that represent the action lifecycle."@en
		;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/678> ;
	rdfs:range drafting:ThreadOfActions ;
	.

uco-action:ActionLifecycle
	rdfs:comment "TODO - This shape is being deactivated in order to deactivate one linked anonymous property shape; the effect is unfortunately overly broad, deactivating other shapes that are restored in drafting:ActionLifecycle-shape."@en ;
	sh:deactivated "true"^^xsd:boolean ;
	.

